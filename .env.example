# Supabase (obrigatório) — Settings -> API do projeto no https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ERP Firebird (rede interna — usado pela sincronização do realizado)
FIREBIRD_HOST=192.168.1.31
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=/opt/firebird/databases/HOFF50.FDB
FIREBIRD_USER=
FIREBIRD_PASSWORD=
FIREBIRD_CHARSET=
# Filiais do ERP a excluir da sincronização (consolidação):
FIREBIRD_EXCLUIR_EMPRESAS=2000,4000

# Segredo para chamar POST /api/sync/erp sem login (agendador)
CRON_SECRET=
